---
/**
 * CalculatorShell — shared page template (PLAN §4). Order: breadcrumbs → tool
 * (above fold) → how-it-works → worked example → related → FAQ → sources.
 * Computes the initial result server-side (SEO + zero CLS). Applies a subtle
 * theme-aware platform accent to the result number + a labelled chip.
 */
import type { CalculatorConfig, ComputeCtx, InputValues } from "../calculators/_types";
import { CATEGORY_META } from "../calculators/_types";
import { relatedCalculators, comparisonsForPlatform } from "../calculators";
import { SITE } from "../config/site";
import { getPlatform } from "../config/platforms";
import { formatCurrency, formatNumber, formatPercent } from "../lib/money";

import Breadcrumbs from "./Breadcrumbs.astro";
import CalculatorIsland from "./CalculatorIsland.tsx";
import FAQ from "./FAQ.astro";
import RelatedCalculators from "./RelatedCalculators.astro";
import RateCards from "./RateCards.astro";
import AdSlot from "./AdSlot.astro";

interface Props {
  config: CalculatorConfig;
}
const { config } = Astro.props;

const cat = CATEGORY_META[config.category];
const platform = getPlatform(config.platform);
const initialCountry = config.countries?.default ?? "US";

const ctx: ComputeCtx = {
  country: initialCountry,
  formatCurrency: (v, opts) => formatCurrency(v, initialCountry, opts),
  formatPercent: (v, dp) => formatPercent(v, dp),
  formatNumber: (v, dp) => formatNumber(v, initialCountry, dp),
};
const defaults: InputValues = Object.fromEntries(
  config.inputs.map((i) => [i.id, i.default]),
);
const initialResult = config.compute(defaults, ctx);

const related = relatedCalculators(config);
const howItWorksParas = config.howItWorks.split("\n\n");
// Render the SEO copy from a tiny, safe subset of Markdown so authored content
// can use headings, **bold**, and "- " bullet lists (the things that make a
// guide scannable instead of a wall of text). Content is authored by us, not
// user input, but we still escape first and only re-introduce the tags we
// support — so set:html can never inject anything unexpected.
const esc = (s: string) =>
  s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const inline = (s: string) =>
  esc(s)
    .replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>")
    .replace(/\[([^\]]+)\]\((https?:\/\/[^)\s]+)\)/g, '<a href="$2" rel="nofollow noopener" target="_blank">$1</a>');
const seoHtml = config.seoContent
  .split("\n\n")
  .map((raw) => raw.trim())
  .filter(Boolean)
  .map((b) => {
    if (b.startsWith("## ")) {
      const nl = b.indexOf("\n");
      const head = nl === -1 ? b.slice(3) : b.slice(3, nl);
      const rest = nl === -1 ? "" : b.slice(nl + 1).trim();
      return `<h3>${inline(head.trim())}</h3>${rest ? `<p>${inline(rest)}</p>` : ""}`;
    }
    const lines = b.split("\n").map((l) => l.trim()).filter(Boolean);
    if (lines.length && lines.every((l) => l.startsWith("- "))) {
      return `<ul>${lines.map((l) => `<li>${inline(l.slice(2))}</li>`).join("")}</ul>`;
    }
    return `<p>${inline(b.replace(/\n/g, " "))}</p>`;
  })
  .join("\n");

const accentStyle = platform
  ? `--accent-l:${platform.color};--accent-d:${platform.colorDark ?? platform.color}`
  : undefined;

// "Compare with other platforms" cross-links: only on single calculators whose
// platform appears in one or more comparison pages. Each link names the OTHER
// platform in the pair (auto-derived from comparisonOf).
const comparisons =
  config.kind === "single" && config.platform
    ? comparisonsForPlatform(config.platform).map((c) => {
        const otherKey = (c.comparisonOf ?? []).find((p) => p !== config.platform);
        return {
          slug: c.slug,
          otherName: getPlatform(otherKey)?.name ?? otherKey ?? "another platform",
        };
      })
    : [];
---

<article class="py-4 pb-12">
  <div class="container mx-auto max-w-[64rem] px-4">
    <Breadcrumbs
      items={[
        { label: "Home", href: "/" },
        { label: cat.label, href: `/${cat.slug}` },
        { label: config.title },
      ]}
    />

    <header class="mb-4 mt-3 max-w-[52rem]">
      <div class="mb-2 flex flex-wrap items-center gap-3">
        <p class="eyebrow">{cat.label}</p>
        {
          platform && (
            <span
              class="calc-accent inline-flex items-center gap-1.5 rounded-full border border-hairline bg-canvas px-2.5 py-0.5 text-[12px] font-medium text-body"
              style={accentStyle}
            >
              <span class="size-2 rounded-full bg-accent" />
              <span translate="no">{platform.name}</span>
            </span>
          )
        }
        {
          config.feesVerifiedOn && (
            <span class="inline-flex items-center gap-1.5 rounded-full border border-hairline bg-canvas-soft px-2.5 py-0.5 text-[12px] text-body">
              Fees verified {config.feesVerifiedOn}
            </span>
          )
        }
      </div>
      <h1>{config.h1}</h1>
      <p class="mt-2 max-w-[42rem] text-[15px] text-body">{config.intro}</p>
    </header>

    <!-- THE TOOL, above the fold -->
    <section class="calc-accent mb-5" aria-label="Calculator" style={accentStyle}>
      <CalculatorIsland
        client:load
        slug={config.slug}
        inputs={config.inputs}
        initialResult={initialResult}
        countryCodes={config.countries?.supported}
        initialCountry={initialCountry}
        showHistory
      />
    </section>

    {
      config.kind === "comparison" && config.comparisonGuide && (
        <section class="mb-6" aria-label="How to use this comparison">
          <div class="rounded-xl border border-link/25 bg-link/[0.06] p-5 shadow-card sm:p-6">
            <div class="flex items-start gap-3">
              <span class="mt-px flex size-7 shrink-0 items-center justify-center rounded-full bg-link/15 text-link" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10" />
                  <path d="M12 16v-4" />
                  <path d="M12 8h.01" />
                </svg>
              </span>
              <div class="min-w-0">
                <p class="text-[17px] font-semibold leading-snug text-ink">How to use this comparison</p>
                <p class="mt-1.5 max-w-[44rem] text-[15px] leading-relaxed text-body">
                  {config.comparisonGuide.howToUse}
                </p>
              </div>
            </div>
            <div class="mt-4 border-t border-link/15 pt-4">
              <p class="font-mono text-[11px] font-medium uppercase tracking-wide text-link">Good to know</p>
              <ul class="mt-2.5 grid list-none gap-2.5 p-0">
                {config.comparisonGuide.notes.map((n) => (
                  <li class="flex gap-2.5 text-[14px] leading-relaxed text-body">
                    <span class="mt-[0.5em] size-1.5 shrink-0 rounded-full bg-link" aria-hidden="true" />
                    <span class="min-w-0">{n}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </section>
      )
    }

    {
      comparisons.length > 0 && platform && (
        <section
          class="calc-accent mb-6"
          aria-label={`Compare ${platform.name} with other platforms`}
          style={accentStyle}
        >
          <div class="card flex flex-col gap-3 p-5 sm:flex-row sm:items-center sm:justify-between">
            <div class="min-w-0">
              <p class="eyebrow">Compare</p>
              <p class="mt-1 text-[15px] font-medium text-ink">
                Wondering if another platform is cheaper? Put{" "}
                <span translate="no">{platform.name}</span> head-to-head.
              </p>
            </div>
            <div class="flex flex-wrap gap-2">
              {comparisons.map((c) => (
                <a href={`/${c.slug}`} class="btn btn-secondary whitespace-nowrap">
                  <span translate="no">{platform.name}</span> vs{" "}
                  <span translate="no">{c.otherName}</span>
                  <span aria-hidden="true"> →</span>
                </a>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <AdSlot slot="in-content" />

    <div class="prose">
      <section aria-labelledby="how-heading">
        <p class="eyebrow">The method</p>
        <h2 id="how-heading" class="mt-1">How it works</h2>
        {howItWorksParas.map((p) => <p>{p}</p>)}
      </section>

      <section class="mt-8" aria-labelledby="example-heading">
        <h2 id="example-heading">Worked example</h2>
        <p>{config.workedExample.scenario}</p>
        <div class="mt-4 max-w-[42rem] rounded-xl border border-hairline border-l-[3px] border-l-accent bg-canvas p-5">
          <dl>
            {
              config.workedExample.steps.map((s) => (
                <div class="flex justify-between gap-4 border-b border-dashed border-hairline py-2">
                  <dt class="text-body">{s.label}</dt>
                  <dd class="tnum font-medium text-ink">{s.value}</dd>
                </div>
              ))
            }
          </dl>
          <p class="tnum mt-4 text-[18px] font-semibold text-accent">
            {config.workedExample.result}
          </p>
        </div>
      </section>
    </div>

    {config.rateCards && <RateCards data={config.rateCards} />}

    <section class="prose mt-10" aria-labelledby="about-heading">
      <p class="eyebrow">Guide</p>
      <h2 id="about-heading" class="mt-1">About the {config.title.replace(" Calculator", "")} calculator</h2>
      <Fragment set:html={seoHtml} />
    </section>

    <RelatedCalculators items={related} />

    <div class="prose">
      <FAQ faqs={config.faqs} />

      <section class="mt-12" aria-labelledby="sources-heading">
        <h2 id="sources-heading">Sources &amp; methodology</h2>
        <ul>
          {
            config.sources.map((s) => (
              <li>
                <a href={s.url} rel="nofollow noopener" target="_blank">
                  {s.label}
                </a>
              </li>
            ))
          }
        </ul>
        <p class="mt-4 text-[13px] text-mute">
          Written &amp; verified by{" "}
          <a href={SITE.author.url} class="font-medium text-body underline-offset-2 hover:underline">{SITE.author.name}</a>,
          {" "}{SITE.author.role}.
          <span class="font-mono"> Last updated {config.lastUpdated}.</span>
        </p>
      </section>
    </div>
  </div>
</article>
