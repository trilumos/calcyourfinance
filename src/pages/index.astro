---
import BaseLayout from "../layouts/BaseLayout.astro";
import FAQ from "../components/FAQ.astro";
import { SITE } from "../config/site";
import { calculators } from "../calculators";
import { CATEGORY_META } from "../calculators/_types";
import { getPlatform } from "../config/platforms";

const singles = calculators.filter((c) => c.kind === "single");
const comparisons = calculators.filter((c) => c.kind === "comparison");

// Featured: the most-searched single tools, in a sensible order.
const featuredOrder = [
  "stripe-fee-calculator",
  "paypal-fee-calculator",
  "square-fee-calculator",
  "venmo-fee-calculator",
  "cashapp-fee-calculator",
  "etsy-fee-calculator",
];
const featured = featuredOrder
  .map((slug) => calculators.find((c) => c.slug === slug))
  .filter((c): c is NonNullable<typeof c> => Boolean(c));

// Theme-aware accent style for a platform's recognition dot.
const accentStyle = (platformId?: string) => {
  const p = getPlatform(platformId);
  return p ? `--accent-l:${p.color};--accent-d:${p.colorDark ?? p.color}` : undefined;
};
// The platforms a comparison features, as accent dots.
const comparisonPlatforms = (slug: string) => {
  const cfg = calculators.find((c) => c.slug === slug);
  return (cfg?.comparisonOf ?? []).map((id) => getPlatform(id)).filter((p): p is NonNullable<typeof p> => Boolean(p));
};

const homeFaqs = [
  {
    q: "Are these fee calculators free?",
    a: "Yes. Every calculator on CalcYourFinance is completely free, needs no signup, and runs entirely in your browser — your numbers never leave your device. We may show ads to keep the site free, but the tools themselves always are.",
  },
  {
    q: "How accurate are the fees?",
    a: "Each rate is taken from the platform's official pricing page, stored in one place, and stamped with the date we last verified it — shown on every calculator. The math behind each tool is unit-tested so the numbers are reproducible. Treat the results as reliable estimates and confirm the final figure in your account before pricing decisions.",
  },
  {
    q: "Which platforms and calculators do you have?",
    a: "Right now we cover payment processors and wallets (Stripe, PayPal, Square, Venmo, Cash App), marketplaces (Etsy), and head-to-head comparisons (Stripe vs PayPal, Stripe vs Square, Square vs PayPal, Cash App vs PayPal, and more). We add new calculators regularly — the goal is a complete library of the fee and finance calculators people actually need.",
  },
  {
    q: "Can I compare two platforms side by side?",
    a: "Yes. Our comparison calculators put two platforms next to each other on the same sale and tell you which is cheaper and by exactly how much — try Stripe vs PayPal or Cash App vs Venmo. Every single-platform calculator also links to the relevant comparisons.",
  },
  {
    q: "Do you support my country?",
    a: "Many calculators are country-aware: pick your country and the rate, currency and worked example update together. Stripe and PayPal cover 22 countries, Square covers 8, and others vary. Where a platform only operates in one country (like Venmo or Cash App in the US), that's noted on the page.",
  },
  {
    q: "How do I work out what to charge to receive an exact amount?",
    a: "Most calculators have a reverse mode: switch to 'I want to receive this amount' and the tool grosses the charge up using charge = (target + fixed fee) ÷ (1 − rate), so you know exactly what to invoice or list to net your target after fees.",
  },
  {
    q: "Who is behind CalcYourFinance?",
    a: `${SITE.author.name} — ${SITE.author.role}. ${SITE.author.bio}`,
  },
];

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: homeFaqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<BaseLayout
  title="Free Fee Calculators — Payment, Processing & Seller Fees | CalcYourFinance"
  description="Free fee calculators for Stripe, PayPal, Square, Venmo, Cash App, Etsy and more. Calculate payment processing and seller fees, compare platforms side by side, and see exactly what you keep — cited, dated rates, no signup."
  canonicalPath="/"
  schemas={[faqLd]}
>
  <!-- Hero -->
  <section class="border-b border-hairline bg-canvas">
    <div class="container mx-auto max-w-[64rem] px-4 py-16 sm:py-24">
      <div class="max-w-[48rem]">
        <p class="eyebrow">No signup · Instant · Cited &amp; dated</p>
        <h1 class="mt-3 text-pretty text-[clamp(2.2rem,1.6rem+2.6vw,3.5rem)]">
          Free fee calculators for every platform.
        </h1>
        <p class="mt-4 max-w-[42rem] text-[18px] leading-relaxed text-body">
          CalcYourFinance is a growing library of fast, accurate calculators for the
          fees that eat into what you earn — payment processors, marketplaces and
          wallets. Work out exactly what each platform takes and what you keep, with
          rates pulled from official pricing pages and dated. New calculators added
          regularly.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="#all-calculators" class="btn btn-primary">Browse all calculators</a>
          <a href="/stripe-vs-paypal-fee-calculator" class="btn btn-secondary">Compare two platforms</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Popular -->
  <section class="container mx-auto max-w-[64rem] px-4 py-12">
    <p class="eyebrow">Popular calculators</p>
    <h2 class="mb-4 mt-1">Start with these.</h2>
    <ul class="grid list-none gap-3 p-0 [grid-template-columns:repeat(auto-fill,minmax(16rem,1fr))]">
      {
        featured.map((c) => {
          const p = getPlatform(c.platform);
          const style = p ? `--accent-l:${p.color};--accent-d:${p.colorDark ?? p.color}` : undefined;
          return (
            <li>
              <a
                href={`/${c.slug}`}
                class="calc-accent card flex h-full flex-col gap-1.5 p-4 no-underline transition hover:border-hairline-strong hover:shadow-float"
                style={style}
              >
                <span class="flex items-center gap-1.5 font-mono text-[11px] uppercase tracking-wide text-mute">
                  {p && <span class="size-1.5 rounded-full bg-accent" />}
                  {CATEGORY_META[c.category].label}
                </span>
                <span class="font-medium text-ink">{c.title}</span>
                <span class="mt-auto text-[13px] text-link">Open →</span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </section>

  <!-- All calculators (full index for internal links + crawlability) -->
  <section id="all-calculators" class="container mx-auto max-w-[64rem] scroll-mt-20 px-4 py-12">
    <p class="eyebrow">All calculators</p>
    <h2 class="mb-6 mt-1">Every tool, in one place.</h2>

    <ul class="grid list-none gap-3 p-0 [grid-template-columns:repeat(auto-fill,minmax(15.5rem,1fr))]">
      {
        singles.map((c) => (
          <li>
            <a
              href={`/${c.slug}`}
              class="calc-accent card group flex items-center gap-3 p-4 no-underline transition hover:border-hairline-strong hover:shadow-float"
              style={accentStyle(c.platform)}
            >
              <span class="size-2.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
              <span class="min-w-0 flex-1">
                <span class="block truncate text-[14px] font-medium text-ink">{c.title}</span>
                <span class="block font-mono text-[10px] uppercase tracking-wide text-mute">
                  {CATEGORY_META[c.category].label}
                </span>
              </span>
              <span class="shrink-0 text-[13px] text-mute transition group-hover:translate-x-0.5" aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="mt-10">
      <p class="eyebrow">Comparisons</p>
      <h3 class="mb-1 mt-1 text-[17px] font-semibold text-ink">Two platforms, head to head.</h3>
      <p class="mb-4 max-w-[40rem] text-[14px] text-body">
        Put two platforms side by side on the same sale and see which is cheaper, and by exactly how much.
      </p>
      <ul class="grid list-none gap-3 p-0 [grid-template-columns:repeat(auto-fill,minmax(15.5rem,1fr))]">
        {
          comparisons.map((c) => (
            <li>
              <a
                href={`/${c.slug}`}
                class="card group flex items-center gap-3 p-4 no-underline transition hover:border-hairline-strong hover:shadow-float"
              >
                <span class="flex shrink-0 items-center -space-x-1">
                  {comparisonPlatforms(c.slug).map((p) => (
                    <span
                      class="calc-accent size-2.5 rounded-full bg-accent ring-2 ring-canvas"
                      style={`--accent-l:${p.color};--accent-d:${p.colorDark ?? p.color}`}
                      aria-hidden="true"
                    />
                  ))}
                </span>
                <span class="min-w-0 flex-1">
                  <span class="block truncate text-[14px] font-medium text-ink">
                    {c.title.replace(" Fee Calculator", "")}
                  </span>
                  <span class="block font-mono text-[10px] uppercase tracking-wide text-mute">Comparison</span>
                </span>
                <span class="shrink-0 text-[13px] text-mute transition group-hover:translate-x-0.5" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Why trust -->
  <section class="container mx-auto max-w-[64rem] px-4 py-12">
    <div class="card max-w-[52rem] p-6 sm:p-10">
      <p class="eyebrow">Why trust these numbers</p>
      <ul class="mt-3 grid list-none gap-3 p-0">
        <li class="relative pl-6 text-body"><span class="absolute left-0 font-bold text-link">✓</span><strong class="text-ink">Cited &amp; dated.</strong> Every fee links to the platform's official pricing page with a "last verified" date.</li>
        <li class="relative pl-6 text-body"><span class="absolute left-0 font-bold text-link">✓</span><strong class="text-ink">Tested math.</strong> Each formula has unit tests, so the numbers are reproducible — not guesses.</li>
        <li class="relative pl-6 text-body"><span class="absolute left-0 font-bold text-link">✓</span><strong class="text-ink">Country-aware.</strong> Rates differ by country — pick yours and the math, currency and example follow.</li>
        <li class="relative pl-6 text-body"><span class="absolute left-0 font-bold text-link">✓</span><strong class="text-ink">Reverse mode.</strong> Work backwards to find what to charge so you receive an exact amount after fees.</li>
      </ul>
      <p class="mt-4 border-t border-dashed border-hairline pt-4 text-[13px] text-mute">{SITE.disclaimer}</p>
    </div>
  </section>

  <!-- SEO content / mission -->
  <section class="container mx-auto max-w-[64rem] px-4 py-4">
    <div class="prose max-w-[46rem]">
      <p class="eyebrow">About CalcYourFinance</p>
      <h2 class="mt-1">A complete, trustworthy library of fee &amp; finance calculators.</h2>
      <p>
        Fees are easy to underestimate and hard to look up. Every payment processor,
        marketplace and platform charges differently — a percentage here, a fixed fee
        there, surcharges for international cards, taxes on the fee in some countries —
        and those small cuts decide whether a sale is actually worth it. CalcYourFinance
        exists to make the real cost obvious. Enter an amount, pick your platform and
        country, and see the fee and exactly what you keep, instantly.
      </p>

      <h3>What this site covers</h3>
      <p>
        We focus first on the fees sellers, freelancers and small businesses search for
        most: <a href="/payment-fees">payment processing fees</a> (Stripe, PayPal,
        Square, Venmo, Cash App) and <a href="/ecommerce-fees">marketplace and seller
        fees</a> (Etsy, with more on the way). On top of the single-platform tools, our
        comparison calculators settle the "which is cheaper" question by putting two
        platforms head-to-head on the same payment. This is a growing library — we add
        new calculators regularly and our goal is to cover every fee and finance
        calculator people genuinely need, not filler nobody uses.
      </p>

      <h3>How the calculators work</h3>
      <p>
        Each tool applies the platform's published rate to your amount: fee = amount ×
        rate% + fixed fee, with surcharges and taxes added where they apply. Country-aware
        calculators adjust the rate, currency and worked example when you change country.
        A reverse mode grosses the charge up so you can find what to invoice to net a
        target. Everything is computed in your browser from pure, unit-tested formulas, so
        results are fast, private and reproducible.
      </p>

      <h3>Why you can trust the numbers</h3>
      <p>
        Getting fees right matters, so every rate is sourced from the platform's official
        pricing page, stored in a single place, and stamped with a "last verified" date
        that's shown on the calculator. When a platform changes its pricing, we update the
        figure and the date together. The site is built and maintained by
        {" "}<a href="/about">{SITE.author.name}</a>, and every calculator cites its
        sources and carries a clear "estimate, not financial advice" note. For day-to-day
        pricing decisions, you get a dependable answer in seconds — and a link to the
        official source if you want to double-check.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="container mx-auto max-w-[64rem] px-4 pb-16">
    <div class="prose max-w-[46rem]">
      <FAQ faqs={homeFaqs} />
    </div>
  </section>
</BaseLayout>
