---
import { SITE } from "../config/site";
import { CATEGORY_META } from "../calculators/_types";
import { activeCategories, calculators } from "../calculators";
import LanguageSwitcher from "./LanguageSwitcher.astro";

const cats = activeCategories().map((c) => CATEGORY_META[c]);

// Client-side search index for the ⌘K command palette. Small (~60 rows), so we
// embed it as JSON rather than fetch it — instant open, works on every page.
const cmdIndex = calculators.map((c) => ({
  slug: c.slug,
  title: c.kind === "comparison" ? c.title.replace(" Fee Calculator", "") : c.title,
  cat: c.kind === "comparison" ? "Comparison" : CATEGORY_META[c.category].label,
  kind: c.kind,
  terms:
    `${c.title} ${CATEGORY_META[c.category].label} ${c.keywords.primary} ${(c.keywords.secondary ?? []).join(" ")}`.toLowerCase(),
}));
---

<header class="sticky top-0 z-50 border-b border-hairline bg-canvas/90 backdrop-blur">
  <div class="container mx-auto flex min-h-[60px] max-w-[64rem] items-center gap-3 px-4 sm:gap-4">
    <a
      href="/"
      class="shrink-0 text-[17px] font-semibold tracking-tight text-ink no-underline"
      aria-label={`${SITE.name} home`}
    >
      <span translate="no">Calc<span class="text-link">Your</span>Finance</span>
    </a>

    <!-- Search is the primary navigation. A faux-input pill that opens the palette.
         Grows to fill (flex-1) so the language + theme controls sit at the container
         edge, aligned with the content below. Compact icon-only on mobile. -->
    <button
      type="button"
      id="cmdk-open"
      data-cmdk-open
      aria-label="Search calculators"
      aria-keyshortcuts="Meta+K Control+K"
      class="group ml-auto flex min-h-9 shrink-0 items-center gap-2 rounded-lg border border-hairline bg-canvas-soft px-2.5 text-mute transition hover:border-hairline-strong hover:text-body sm:ml-2 sm:flex-1 sm:px-3"
    >
      <svg
        class="size-[18px] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor"
        stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
      >
        <circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" />
      </svg>
      <span class="hidden flex-1 text-left text-[14px] sm:block">Search calculators…</span>
      <kbd
        class="hidden shrink-0 rounded border border-hairline bg-canvas px-1.5 py-0.5 font-mono text-[11px] text-mute group-hover:border-hairline-strong sm:block"
        aria-hidden="true"
      >⌘K</kbd>
    </button>

    <div class="flex shrink-0 items-center gap-3">
      <LanguageSwitcher />
      <button
        type="button"
        id="theme-toggle"
        class="grid size-9 place-items-center rounded-md border border-hairline bg-canvas text-body hover:border-hairline-strong hover:text-ink"
        aria-label="Toggle dark mode"
      >
        <svg class="block dark:hidden" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
        <svg class="hidden dark:block" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path></svg>
      </button>
    </div>
  </div>
</header>

<!-- ⌘K command palette: global search over every calculator. -->
<div id="cmdk" hidden class="fixed inset-0 z-[100] flex items-start justify-center px-4 pt-[12vh]">
  <div class="absolute inset-0 bg-ink/40 backdrop-blur-sm" data-cmdk-close aria-hidden="true"></div>
  <div
    class="card relative flex max-h-[70vh] w-full max-w-[36rem] flex-col overflow-hidden p-0 shadow-float"
    role="dialog"
    aria-modal="true"
    aria-label="Search calculators"
  >
    <div class="flex items-center gap-2.5 border-b border-hairline px-4">
      <svg
        class="size-[18px] shrink-0 text-mute" viewBox="0 0 24 24" fill="none" stroke="currentColor"
        stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
      >
        <circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" />
      </svg>
      <input
        id="cmdk-input"
        type="text"
        class="w-full bg-transparent py-3.5 text-[15px] text-ink outline-none focus:outline-none focus-visible:outline-none placeholder:text-mute"
        placeholder="Search calculators — try 'stripe', 'emi', 'vs'…"
        aria-label="Search calculators"
        role="combobox"
        aria-expanded="true"
        aria-controls="cmdk-list"
        aria-autocomplete="list"
        autocomplete="off"
        spellcheck="false"
      />
      <kbd class="hidden shrink-0 rounded border border-hairline px-1.5 py-0.5 font-mono text-[11px] text-mute sm:block" aria-hidden="true">Esc</kbd>
    </div>

    <ul id="cmdk-list" role="listbox" aria-label="Calculators" class="flex-1 list-none overflow-y-auto overscroll-contain p-2"></ul>
    <p id="cmdk-empty" hidden class="px-4 py-8 text-center text-[14px] text-mute">
      No calculator matches. Try a platform name like <strong class="text-ink">Stripe</strong> or a topic like <strong class="text-ink">EMI</strong>.
    </p>

    <div class="flex flex-wrap items-center gap-x-4 gap-y-1 border-t border-hairline bg-canvas-soft px-4 py-2.5">
      <span class="eyebrow">Browse</span>
      {cats.map((c) => (
        <a href={`/${c.slug}`} class="text-[13px] font-medium text-body no-underline hover:text-ink hover:underline">
          {c.label}
        </a>
      ))}
    </div>
  </div>
</div>

<script type="application/json" id="cmdk-data" set:html={JSON.stringify(cmdIndex)}></script>

<script is:inline>
  (function () {
    var btn = document.getElementById("theme-toggle");
    if (!btn) return;
    btn.addEventListener("click", function () {
      var cur = document.documentElement.dataset.theme === "dark" ? "dark" : "light";
      var next = cur === "dark" ? "light" : "dark";
      document.documentElement.dataset.theme = next;
      try {
        localStorage.setItem("theme", next);
      } catch (e) {}
    });
  })();
</script>

<script>
  // ⌘K command palette — global fuzzy-ish search over all calculators. Vanilla,
  // no deps; the index is embedded as JSON by the server.
  interface Row { slug: string; title: string; cat: string; kind: string; terms: string }

  // Fixed category order for the default (empty-query) browse view.
  const CAT_ORDER: Record<string, number> = {
    "Payment Fees": 0,
    "Personal Finance": 1,
    "E-commerce & Seller Fees": 2,
    Comparison: 3,
  };

  const overlay = document.getElementById("cmdk");
  const input = document.getElementById("cmdk-input") as HTMLInputElement | null;
  const list = document.getElementById("cmdk-list");
  const empty = document.getElementById("cmdk-empty");
  // Any [data-cmdk-open] element opens the palette (header button, page CTAs).
  const openers = Array.from(document.querySelectorAll<HTMLElement>("[data-cmdk-open]"));
  const dataEl = document.getElementById("cmdk-data");

  if (overlay && input && list && empty && openers.length && dataEl) {
    const rows: Row[] = JSON.parse(dataEl.textContent || "[]");
    let results: Row[] = [];
    let active = 0;
    let lastFocused: HTMLElement | null = null;

    const score = (r: Row, q: string): number => {
      const t = r.title.toLowerCase();
      if (t === q) return 100;
      if (t.startsWith(q)) return 80;
      if (t.includes(q)) return 60;
      if (r.terms.includes(q)) return 40;
      // token match: every query word appears somewhere
      const words = q.split(/\s+/).filter(Boolean);
      if (words.length > 1 && words.every((w) => r.terms.includes(w))) return 30;
      return 0;
    };

    function render() {
      const q = input!.value.trim().toLowerCase();
      // Comparison intent: the query has a second token starting with "v" (e.g.
      // "stripe v", "stripe vs paypal"). Then rank comparisons first; otherwise
      // the single/exact calculator ranks above its comparisons.
      const compIntent = q.includes(" v");
      if (q === "") {
        results = rows.slice().sort((a, b) => (CAT_ORDER[a.cat] ?? 9) - (CAT_ORDER[b.cat] ?? 9));
      } else {
        results = rows
          .map((r) => ({ r, s: score(r, q) }))
          .filter((x) => x.s > 0)
          .sort((a, b) => {
            if (b.s !== a.s) return b.s - a.s;
            const aComp = a.r.kind === "comparison" ? 1 : 0;
            const bComp = b.r.kind === "comparison" ? 1 : 0;
            if (aComp !== bComp) return compIntent ? bComp - aComp : aComp - bComp;
            return a.r.title.length - b.r.title.length;
          })
          .map((x) => x.r);
      }
      results = results.slice(0, 40);
      active = 0;

      empty!.hidden = results.length > 0;
      list!.innerHTML = "";
      let curCat = "";
      results.forEach((r, i) => {
        if (r.cat !== curCat) {
          curCat = r.cat;
          const h = document.createElement("li");
          h.setAttribute("role", "presentation");
          h.className = "eyebrow px-2 pb-1 pt-2.5";
          h.textContent = curCat;
          list!.appendChild(h);
        }
        const li = document.createElement("li");
        li.setAttribute("role", "option");
        li.id = "cmdk-opt-" + i;
        li.dataset.i = String(i);
        li.setAttribute("aria-selected", i === active ? "true" : "false");
        li.className =
          "group flex cursor-pointer items-center justify-between gap-3 rounded-lg px-2 py-2 text-[14px] no-underline aria-selected:bg-canvas-soft";
        const a = document.createElement("a");
        a.href = "/" + r.slug;
        a.tabIndex = -1; // combobox pattern: navigate options via arrows, not Tab
        a.className = "min-w-0 flex-1 truncate font-medium text-ink no-underline";
        a.textContent = r.title;
        const arrow = document.createElement("span");
        // ↵ hint only on the active/hovered row (Linear/Raycast style).
        arrow.className =
          "shrink-0 text-[13px] text-mute opacity-0 transition-opacity group-hover:opacity-100 group-aria-selected:opacity-100";
        arrow.setAttribute("aria-hidden", "true");
        arrow.textContent = "↵";
        li.appendChild(a);
        li.appendChild(arrow);
        li.addEventListener("click", () => go(i));
        li.addEventListener("mousemove", () => setActive(i));
        list!.appendChild(li);
      });
      input!.setAttribute("aria-activedescendant", results.length ? "cmdk-opt-0" : "");
    }

    function setActive(i: number) {
      if (!results.length) return;
      active = (i + results.length) % results.length;
      const opts = list!.querySelectorAll<HTMLElement>('[role="option"]');
      opts.forEach((o) => o.setAttribute("aria-selected", o.dataset.i === String(active) ? "true" : "false"));
      const el = list!.querySelector<HTMLElement>('[data-i="' + active + '"]');
      if (el) el.scrollIntoView({ block: "nearest" });
      input!.setAttribute("aria-activedescendant", "cmdk-opt-" + active);
    }

    function go(i: number) {
      const r = results[i];
      if (r) window.location.href = "/" + r.slug;
    }

    function open() {
      lastFocused = document.activeElement as HTMLElement;
      overlay!.hidden = false;
      document.documentElement.style.overflow = "hidden";
      input!.value = "";
      render();
      input!.focus();
    }
    function close() {
      overlay!.hidden = true;
      document.documentElement.style.overflow = "";
      if (lastFocused) lastFocused.focus();
    }

    openers.forEach((el) => el.addEventListener("click", open));
    overlay.querySelectorAll("[data-cmdk-close]").forEach((el) => el.addEventListener("click", close));
    input.addEventListener("input", render);

    // Trap Tab within the open dialog (input + footer category links only —
    // result options are reached with arrow keys, not Tab).
    overlay.addEventListener("keydown", (e) => {
      if (e.key !== "Tab") return;
      const f = overlay!.querySelectorAll<HTMLElement>('input, a[href]:not([tabindex="-1"])');
      if (!f.length) return;
      const first = f[0];
      const last = f[f.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    });

    input.addEventListener("keydown", (e) => {
      if (e.key === "ArrowDown") { e.preventDefault(); setActive(active + 1); }
      else if (e.key === "ArrowUp") { e.preventDefault(); setActive(active - 1); }
      else if (e.key === "Enter") { e.preventDefault(); go(active); }
      else if (e.key === "Escape") { e.preventDefault(); close(); }
    });

    // Global shortcuts: ⌘K / Ctrl+K toggles; "/" opens when not already typing.
    document.addEventListener("keydown", (e) => {
      const k = e.key.toLowerCase();
      if ((e.metaKey || e.ctrlKey) && k === "k") {
        e.preventDefault();
        overlay!.hidden ? open() : close();
      } else if (k === "escape" && !overlay!.hidden) {
        close();
      } else if (
        e.key === "/" &&
        overlay!.hidden &&
        !/^(input|textarea|select)$/i.test((e.target as HTMLElement)?.tagName) &&
        !(e.target as HTMLElement)?.isContentEditable
      ) {
        e.preventDefault();
        open();
      }
    });
  }
</script>
