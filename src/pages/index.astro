---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../config/site";
import { calculators, activeCategories } from "../calculators";
import { CATEGORY_META } from "../calculators/_types";
import { getPlatform } from "../config/platforms";

const featured = calculators.slice(0, 6);
const cats = activeCategories().map((c) => CATEGORY_META[c]);
---

<BaseLayout
  title={`${SITE.name} — Free Finance & E-commerce Calculators`}
  description={SITE.description}
  canonicalPath="/"
>
  <section class="border-b border-hairline bg-canvas">
    <div class="container mx-auto max-w-[64rem] px-4 py-16 sm:py-24">
      <div class="max-w-[46rem]">
        <p class="eyebrow">No signup · Instant · Mobile-first</p>
        <h1 class="mt-3 text-[clamp(2.2rem,1.6rem+2.6vw,3.5rem)]">The fees, taken care of.</h1>
        <p class="mt-4 max-w-[40rem] text-[18px] leading-relaxed text-body">
          Free, fast calculators for Stripe, PayPal and Etsy fees, payment processing,
          AI &amp; API costs and everyday finance. Every fee is cited and dated — so you
          know exactly what you keep.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/stripe-fee-calculator" class="btn btn-primary">Try the Stripe calculator</a>
          <a href="/payment-fees" class="btn btn-secondary">Browse all calculators</a>
        </div>
      </div>
    </div>
  </section>

  <section class="container mx-auto max-w-[64rem] px-4 py-12">
    <p class="eyebrow">Popular calculators</p>
    <h2 class="mb-4 mt-1">Start with these.</h2>
    <ul class="grid list-none gap-3 p-0 [grid-template-columns:repeat(auto-fill,minmax(16rem,1fr))]">
      {
        featured.map((c) => {
          const p = getPlatform(c.platform);
          const style = p ? `--accent-l:${p.color};--accent-d:${p.colorDark ?? p.color}` : undefined;
          return (
            <li>
              <a href={`/${c.slug}`} class="calc-accent card flex h-full flex-col gap-1.5 p-4 no-underline transition hover:border-hairline-strong hover:shadow-float" style={style}>
                <span class="flex items-center gap-1.5 font-mono text-[11px] uppercase tracking-wide text-mute">
                  {p && <span class="size-1.5 rounded-full bg-accent" />}
                  {CATEGORY_META[c.category].label}
                </span>
                <span class="font-medium text-ink">{c.title}</span>
                <span class="mt-auto text-[13px] text-link">Open →</span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </section>

  <section class="container mx-auto max-w-[64rem] px-4 py-12">
    <p class="eyebrow">By category</p>
    <h2 class="mb-4 mt-1">Find your tool.</h2>
    <ul class="grid list-none gap-3 p-0 [grid-template-columns:repeat(auto-fill,minmax(18rem,1fr))]">
      {
        cats.map((c) => (
          <li>
            <a href={`/${c.slug}`} class="card block border-l-[3px] border-l-ink p-4 no-underline transition hover:translate-x-0.5">
              <span class="block font-medium text-ink">{c.label}</span>
              <span class="mt-1 block text-[13px] text-body">{c.blurb}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="container mx-auto max-w-[64rem] px-4 pb-16 pt-12">
    <div class="card max-w-[52rem] p-6 sm:p-10">
      <p class="eyebrow">Why trust these numbers</p>
      <ul class="mt-3 grid list-none gap-3 p-0">
        <li class="relative pl-6 text-body"><span class="absolute left-0 font-bold text-link">✓</span><strong class="text-ink">Cited &amp; dated.</strong> Every fee links to the platform's official pricing page with a "last verified" date.</li>
        <li class="relative pl-6 text-body"><span class="absolute left-0 font-bold text-link">✓</span><strong class="text-ink">Tested math.</strong> Each formula has unit tests, so the numbers are reproducible.</li>
        <li class="relative pl-6 text-body"><span class="absolute left-0 font-bold text-link">✓</span><strong class="text-ink">Country-aware.</strong> Rates differ by country — pick yours and the math follows.</li>
      </ul>
      <p class="mt-4 border-t border-dashed border-hairline pt-4 text-[13px] text-mute">{SITE.disclaimer}</p>
    </div>
  </section>
</BaseLayout>
