---
import BaseLayout from "../layouts/BaseLayout.astro";
import FAQ from "../components/FAQ.astro";
import { SITE } from "../config/site";
import { calculators } from "../calculators";
import { CATEGORY_META, type Category } from "../calculators/_types";
import { getPlatform } from "../config/platforms";
import { demandRank } from "../config/demand";
import CalculatorIsland from "../components/CalculatorIsland.tsx";
import { formatCurrency, formatNumber, formatPercent } from "../lib/money";
import type { ComputeCtx, InputValues } from "../calculators/_types";

const singles = calculators.filter((c) => c.kind === "single");
const comparisons = calculators.filter((c) => c.kind === "comparison");
const total = singles.length + comparisons.length;

// Interactive "try it here" tabs in the hero — a few popular calculators,
// computed server-side (numbers in the HTML, SEO-safe) and hydrated per-tab.
const heroTabOrder: { slug: string; label: string }[] = [
  { slug: "gst-calculator", label: "GST" },
  { slug: "emi-calculator", label: "EMI" },
  { slug: "sip-calculator", label: "SIP" },
  { slug: "stripe-fee-calculator", label: "Stripe" },
  { slug: "etsy-fee-calculator", label: "Etsy" },
];
const heroTabs = heroTabOrder
  .map(({ slug, label }) => {
    const config = calculators.find((c) => c.slug === slug);
    if (!config) return null;
    const initialCountry = config.countries?.default ?? "US";
    const ctx: ComputeCtx = {
      country: initialCountry,
      formatCurrency: (v, opts) => formatCurrency(v, initialCountry, opts),
      formatPercent: (v, dp) => formatPercent(v, dp),
      formatNumber: (v, dp) => formatNumber(v, initialCountry, dp),
    };
    const defaults: InputValues = Object.fromEntries(config.inputs.map((i) => [i.id, i.default]));
    return { config, label, initialCountry, initialResult: config.compute(defaults, ctx) };
  })
  .filter((t): t is NonNullable<typeof t> => Boolean(t));

// Group single calculators by category, in a curated presentation order.
const CATEGORY_ORDER: Category[] = [
  "payment-fees",
  "personal-finance",
  "ecommerce-fees",
  "ai-api-costs",
  "freelance",
  "general",
];
// The homepage shows a curated subset per category and links to the hub for the
// rest: selective homepage linking concentrates equity on the hubs and keeps every
// calculator within 2 clicks.
// Bento size hierarchy: a category with many calculators earns a full-width panel
// (two inner columns) and shows more of them; the rest sit in equal half panels.
// Ordering: a researched estVolume always wins (real data). Where it's absent —
// most payment/e-commerce configs, since keyword volumes are gated behind paid
// tools — fall back to the explicit editorial demand ranking in config/demand.ts,
// then alphabetical. Never alphabetical-first: people want the big platforms.
const WIDE_THRESHOLD = 20;
const byDemand = (a: (typeof singles)[number], b: (typeof singles)[number]) => {
  const va = a.keywords.estVolume ?? 0;
  const vb = b.keywords.estVolume ?? 0;
  if (va !== vb) return vb - va;
  const ra = demandRank(a.category, a.slug);
  const rb = demandRank(b.category, b.slug);
  return ra - rb || a.title.localeCompare(b.title);
};
const groups = CATEGORY_ORDER.map((cat) => {
  const items = singles.filter((c) => c.category === cat);
  const wide = items.length >= WIDE_THRESHOLD;
  return {
    cat,
    meta: CATEGORY_META[cat],
    items,
    wide,
    featured: [...items].sort(byDemand).slice(0, wide ? 12 : 8),
  };
}).filter((g) => g.items.length > 0);

// Theme-aware accent style for a platform's recognition dot / left bar.
const accentStyle = (platformId?: string) => {
  const p = getPlatform(platformId);
  return p ? `--accent-l:${p.color};--accent-d:${p.colorDark ?? p.color}` : undefined;
};
// Freshness signal: the calculators whose rates we verified most recently.
// Every config carries lastUpdated; fee calculators also carry feesVerifiedOn.
const verifiedOn = (c: (typeof calculators)[number]) => c.feesVerifiedOn ?? c.lastUpdated;
const recentlyVerified = [...calculators]
  .sort((a, b) => verifiedOn(b).localeCompare(verifiedOn(a)))
  .slice(0, 6);
const prettyDate = (iso: string) =>
  new Date(`${iso}T00:00:00Z`).toLocaleDateString("en-GB", {
    day: "numeric",
    month: "short",
    year: "numeric",
    timeZone: "UTC",
  });

const homeFaqs = [
  {
    q: "Are these calculators free?",
    a: "Yes. Every calculator on CalcYourFinance is completely free, needs no signup, and runs entirely in your browser — your numbers never leave your device. We may show ads to keep the site free, but the tools themselves always are.",
  },
  {
    q: "How accurate are the fees and figures?",
    a: "Each platform fee is taken from the official pricing page, stored in one place, and stamped with the date we last verified it — shown on every calculator. The finance formulas (EMI, SIP, compound interest and the rest) are standard textbook math, and every formula is unit-tested so the numbers are reproducible. Treat the results as reliable estimates and confirm the final figure before pricing decisions.",
  },
  {
    q: "Which calculators do you have?",
    a: "Three groups: payment-processor and wallet fees (Stripe, PayPal, Square, Venmo, Cash App, Wise, Payoneer, Razorpay and more), marketplace and seller fees (Etsy, with more rolling out), and personal-finance math (EMI, loan, SIP, FD, RD, GST, compound interest, simple interest, salary and percentage). Plus head-to-head fee comparisons. We add new calculators regularly.",
  },
  {
    q: "Can I compare two platforms side by side?",
    a: "Yes. Our comparison calculators put two platforms next to each other on the same sale and tell you which is cheaper and by exactly how much — try Stripe vs PayPal or Cash App vs Venmo. Every single-platform calculator also links to the relevant comparisons.",
  },
  {
    q: "Does it show my currency?",
    a: "Yes — the calculators detect your region and show results in your currency automatically (₹ in India, $ in the US, and so on), and you can switch country from the selector on any country-aware calculator. Fee rates that differ by country update together with the currency and worked example.",
  },
  {
    q: "How do I work out what to charge to receive an exact amount?",
    a: "Most fee calculators have a reverse mode: switch to 'I want to receive this amount' and the tool grosses the charge up using charge = (target + fixed fee) ÷ (1 − rate), so you know exactly what to invoice or list to net your target after fees.",
  },
  {
    q: "Who is behind CalcYourFinance?",
    a: `${SITE.author.name} — ${SITE.author.role}. ${SITE.author.bio}`,
  },
];

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: homeFaqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<BaseLayout
  title="Free Fee & Finance Calculators — Stripe, PayPal, EMI, SIP, GST & more | CalcYourFinance"
  description="Free calculators for payment & seller fees (Stripe, PayPal, Square, Etsy) and personal finance (EMI, SIP, FD, GST, compound interest). Accurate, cited, in your own currency — no signup."
  canonicalPath="/"
  schemas={[faqLd]}
>
  <!-- Hero: centered title + a focused live calculator, sized to fit one viewport. -->
  <section class="relative border-b border-hairline bg-canvas">
    <div class="hero-backdrop" aria-hidden="true"></div>
    <div class="container relative z-10 mx-auto flex min-h-[calc(100svh-3.75rem)] max-w-[64rem] flex-col justify-center px-4 py-8">
      <div class="mx-auto max-w-[42rem] text-center">
        <h1 class="text-balance text-[clamp(1.9rem,1.4rem+2.2vw,2.7rem)]">
          Fee and finance calculators you can trust.
        </h1>
        <p class="mx-auto mt-3 max-w-[38rem] text-pretty text-[16px] leading-relaxed text-body">
          {total} free calculators — Stripe, PayPal, Etsy, Amazon and more — plus the everyday
          finance math. Every rate comes from the official pricing page and carries the date we
          checked it.
        </p>
      </div>

      <!-- Live demo: full-width so tall calcs (Stripe/Etsy) get more horizontal
           room and stay closer to one viewport. Inputs and result side by side (md+). -->
      <div class="mt-7 w-full" data-calc-tabs>
        <div
          role="tablist"
          aria-label="Try a calculator"
          class="mx-auto mb-3 flex w-fit max-w-full flex-wrap justify-center gap-1 rounded-xl border border-hairline bg-canvas-soft p-1"
        >
          {
            heroTabs.map((t, i) => (
              <button
                type="button"
                role="tab"
                id={`htab-${i}`}
                aria-controls={`hpanel-${i}`}
                aria-selected={i === 0 ? "true" : "false"}
                tabindex={i === 0 ? 0 : -1}
                class="whitespace-nowrap rounded-lg px-3 py-1.5 text-[13px] font-medium text-body transition hover:text-ink aria-selected:bg-canvas aria-selected:text-ink aria-selected:shadow-card"
              >
                {t.label}
              </button>
            ))
          }
        </div>
        {
          heroTabs.map((t, i) => (
            <div
              role="tabpanel"
              id={`hpanel-${i}`}
              aria-labelledby={`htab-${i}`}
              hidden={i !== 0}
              class="calc-accent"
              style={accentStyle(t.config.platform)}
            >
              <CalculatorIsland
                client:visible
                slug={t.config.slug}
                inputs={t.config.inputs}
                initialResult={t.initialResult}
                countryCodes={t.config.countries?.supported}
                initialCountry={t.initialCountry}
              />
              <p class="mt-2.5 text-center text-[12px] text-mute">
                Full version with worked example, FAQ and sources:{" "}
                <a href={`/${t.config.slug}`} class="text-link no-underline hover:underline">
                  {t.config.title} →
                </a>
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Browse by category: first thing on scroll (search lives in the navbar). -->
  <section class="border-b border-hairline bg-canvas-soft">
    <nav
      class="container mx-auto flex max-w-[64rem] flex-wrap items-center justify-center gap-2 px-4 py-4"
      aria-label="Browse by category"
    >
      <span class="eyebrow mr-1">Browse</span>
      {
        groups.map((g) => (
          <a
            href={`/${g.meta.slug}`}
            class="inline-flex items-center gap-2 rounded-full border border-hairline bg-canvas px-3.5 py-1.5 text-[13px] font-medium text-ink no-underline transition hover:border-hairline-strong hover:shadow-card"
          >
            {g.meta.label}
            <span class="tnum font-mono text-[11px] text-mute">{g.items.length}</span>
          </a>
        ))
      }
      {comparisons.length > 0 && (
        <a
          href="#comparisons"
          class="inline-flex items-center gap-2 rounded-full border border-hairline bg-canvas px-3.5 py-1.5 text-[13px] font-medium text-ink no-underline transition hover:border-hairline-strong hover:shadow-card"
        >
          Comparisons
          <span class="tnum font-mono text-[11px] text-mute">{comparisons.length}</span>
        </a>
      )}
    </nav>
  </section>

  <!-- Featured comparisons: highest-intent, fastest-ranking page type — surfaced early. -->
  {comparisons.length > 0 && (
    <section id="comparisons" class="container mx-auto max-w-[64rem] scroll-mt-20 px-4 py-12" aria-labelledby="cmp-h">
      <h2 id="cmp-h" class="mb-1 mt-1">Which platform actually costs less?</h2>
      <p class="mb-6 max-w-[42rem] text-[15px] text-body">
        Put two platforms side by side on the same sale and see which is cheaper — and by exactly
        how much, after every fee.
      </p>
      <ul class="grid list-none gap-3 p-0 [grid-template-columns:repeat(auto-fill,minmax(17rem,1fr))]">
        {comparisons.map((c) => (
          <li>
            <a
              href={`/${c.slug}`}
              class="card group flex h-full items-center justify-between gap-3 p-5 no-underline transition hover:border-hairline-strong hover:shadow-float"
            >
              <span class="text-[15px] font-medium text-ink">
                {c.title.replace(" Fee Calculator", "")}
              </span>
              <span
                class="shrink-0 text-[13px] text-mute transition group-hover:translate-x-0.5"
                aria-hidden="true"
              >→</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <!-- Browse by category: a symmetric 2x2 bento — three category panels of equal
       height (8 rows each) plus a search panel that completes the square. Each
       panel links to its hub with keyword-rich anchor text. -->
  <section id="all-calculators" class="container mx-auto max-w-[64rem] scroll-mt-20 px-4 py-12" aria-labelledby="all-h">
    <h2 id="all-h" class="mb-1 mt-1">Browse by category.</h2>
    <p class="mb-6 max-w-[42rem] text-[15px] text-body">
      {total} calculators across {groups.length} categories. The most-searched in each are below —
      open a category for its full list, or press <kbd class="rounded border border-hairline bg-canvas-soft px-1.5 py-0.5 font-mono text-[11px] text-mute">⌘K</kbd> to search them all.
    </p>

    <div class="grid gap-4 md:grid-cols-2">
      {
        groups.map((g) => (
          <section
            class={`card flex flex-col p-5 ${g.wide ? "md:col-span-2" : ""}`}
            aria-labelledby={`grp-${g.cat}`}
          >
            <div class="mb-3 flex items-baseline justify-between gap-3">
              <h3 id={`grp-${g.cat}`} class="text-[15px] font-semibold text-ink">{g.meta.label}</h3>
              <span class="tnum shrink-0 font-mono text-[11px] text-body">{g.items.length}</span>
            </div>
            <ul
              class={`-mx-2 list-none p-0 ${g.wide ? "sm:grid sm:grid-cols-2 sm:gap-x-6 [&>li:nth-last-child(-n+2)]:sm:border-b-0" : ""}`}
            >
              {g.featured.map((c) => (
                <li class="border-b border-hairline last:border-b-0">
                  <a
                    href={`/${c.slug}`}
                    class="group flex items-center gap-3 rounded-md px-2 py-[0.55rem] no-underline transition hover:bg-canvas-soft-2"
                  >
                    <span class="min-w-0 flex-1 truncate text-[14px] text-ink">{c.title}</span>
                    <span
                      class="shrink-0 text-[13px] text-mute opacity-0 transition group-hover:translate-x-0.5 group-hover:opacity-100"
                      aria-hidden="true"
                    >→</span>
                  </a>
                </li>
              ))}
            </ul>
            <a
              href={`/${g.meta.slug}`}
              class="mt-auto pt-3 text-[13px] font-medium text-link no-underline hover:underline"
            >
              View all {g.meta.label.toLowerCase()} calculators →
            </a>
          </section>
        ))
      }

    </div>
  </section>

  <!-- Why trust + how we verify (merged: the E-E-A-T / information-gain section) -->
  <section class="container mx-auto max-w-[64rem] px-4 py-12" aria-labelledby="trust-h">
    <h2 id="trust-h" class="mb-1 mt-1">Numbers you can check for yourself.</h2>
    <p class="mb-6 max-w-[42rem] text-[15px] text-body">
      Most fee calculators never tell you where their rates came from, or when they were last
      correct. Ours do — on every calculator.
    </p>

    <div class="grid gap-4 md:grid-cols-2">
      <div class="card p-6">
        <h3 class="mb-3 text-[15px] font-semibold text-ink">What you get</h3>
        <ul class="grid list-none gap-3 p-0 text-[14px]">
          <li class="relative pl-6 text-body"><span class="absolute left-0 font-bold text-link" aria-hidden="true">✓</span><strong class="text-ink">Cited &amp; dated.</strong> Every fee links to the platform's official pricing page with the date we last verified it.</li>
          <li class="relative pl-6 text-body"><span class="absolute left-0 font-bold text-link" aria-hidden="true">✓</span><strong class="text-ink">Tested math.</strong> Each formula has unit tests, so the numbers are reproducible — not guesses.</li>
          <li class="relative pl-6 text-body"><span class="absolute left-0 font-bold text-link" aria-hidden="true">✓</span><strong class="text-ink">Your currency.</strong> Results follow your region; country-aware fees update the rate and worked example too.</li>
          <li class="relative pl-6 text-body"><span class="absolute left-0 font-bold text-link" aria-hidden="true">✓</span><strong class="text-ink">Reverse mode.</strong> Work backwards to find what to charge so you receive an exact amount after fees.</li>
        </ul>
      </div>

      <div class="card p-6">
        <h3 class="mb-3 text-[15px] font-semibold text-ink">How we verify a rate</h3>
        <ol class="grid list-none gap-3 p-0 text-[14px]">
          <li class="relative pl-7 text-body"><span class="tnum absolute left-0 font-mono text-[12px] text-mute" aria-hidden="true">01</span>Take the rate straight from the platform's <strong class="text-ink">official pricing page</strong> — never a third-party summary.</li>
          <li class="relative pl-7 text-body"><span class="tnum absolute left-0 font-mono text-[12px] text-mute" aria-hidden="true">02</span>Record it in <strong class="text-ink">one shared source of truth</strong>, stamped with the date it was checked.</li>
          <li class="relative pl-7 text-body"><span class="tnum absolute left-0 font-mono text-[12px] text-mute" aria-hidden="true">03</span>Encode the math as a <strong class="text-ink">unit-tested function</strong>, so every result is reproducible.</li>
          <li class="relative pl-7 text-body"><span class="tnum absolute left-0 font-mono text-[12px] text-mute" aria-hidden="true">04</span>When a platform changes its pricing, the <strong class="text-ink">figure and the date move together</strong>.</li>
        </ol>
        <p class="mt-4 text-[13px]">
          <a href="/methodology" class="text-link no-underline hover:underline">Read the full methodology →</a>
        </p>
      </div>
    </div>

    <p class="mt-4 max-w-[52rem] border-t border-dashed border-hairline pt-4 text-[13px] text-mute">{SITE.disclaimer}</p>
  </section>

  <!-- Recently verified: freshness signal, straight from each config's verified date. -->
  <section class="container mx-auto max-w-[64rem] px-4 py-12" aria-labelledby="fresh-h">
    <h2 id="fresh-h" class="mb-1 mt-1">Rates we checked most recently.</h2>
    <p class="mb-6 max-w-[42rem] text-[15px] text-body">
      Every calculator shows when its rates were last verified against the official source. Here are
      the latest.
    </p>
    <ul class="grid list-none gap-3 p-0 [grid-template-columns:repeat(auto-fill,minmax(17rem,1fr))]">
      {
        recentlyVerified.map((c) => (
          <li>
            <a
              href={`/${c.slug}`}
              class="card flex h-full items-center justify-between gap-3 p-4 no-underline transition hover:border-hairline-strong hover:shadow-float"
            >
              <span class="min-w-0 flex-1">
                <span class="block truncate text-[14px] font-medium text-ink">{c.title}</span>
                <span class="block font-mono text-[10px] uppercase tracking-wide text-body">
                  {CATEGORY_META[c.category].label}
                </span>
              </span>
              <time
                datetime={verifiedOn(c)}
                class="tnum shrink-0 whitespace-nowrap font-mono text-[11px] text-body"
              >
                {prettyDate(verifiedOn(c))}
              </time>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- SEO content / mission -->
  <section class="container mx-auto max-w-[64rem] px-4 py-4" aria-labelledby="about-h">
    <div class="prose max-w-[46rem]">
      <h2 id="about-h" class="mt-1">A complete, trustworthy library of fee &amp; finance calculators.</h2>
      <p>
        Fees are easy to underestimate and finance math is easy to get wrong. Every payment
        processor and marketplace charges differently — a percentage here, a fixed fee there,
        surcharges for international cards — and everyday questions like an EMI, an SIP return or
        the GST on a bill deserve an exact answer. CalcYourFinance makes both obvious: enter your
        numbers, pick your platform or country, and see the result and exactly what you keep,
        instantly and in your own currency.
      </p>

      <h3>What this site covers</h3>
      <p>
        We focus on the calculators people search for most: <a href="/payment-fees">payment
        processing fees</a> (Stripe, PayPal, Square, Venmo, Cash App, Wise, Payoneer and more),
        <a href="/ecommerce-fees">marketplace and seller fees</a> (Etsy, with more rolling out),
        and <a href="/personal-finance">personal-finance tools</a> (EMI, loan, SIP, FD, RD, GST,
        compound and simple interest, salary and percentage). On top of the single-platform tools,
        our comparison calculators settle the "which is cheaper" question by putting two platforms
        head-to-head on the same payment. This is a growing library — our goal is every fee and
        finance calculator people genuinely need, not filler nobody uses.
      </p>

      <h3>How the calculators work</h3>
      <p>
        Fee tools apply the platform's published rate to your amount: fee = amount × rate% + fixed
        fee, with surcharges and taxes added where they apply. Finance tools use the standard
        formulas — compound interest, EMI amortisation, annuity future value and so on. Everything
        is computed in your browser from pure, unit-tested formulas, and the currency follows your
        region, so results are fast, private, accurate and reproducible.
      </p>

      <h3>Why you can trust the numbers</h3>
      <p>
        Getting these right matters, so every platform rate is sourced from the official pricing
        page, stored in a single place, and stamped with a "last verified" date shown on the
        calculator. When a platform changes its pricing, we update the figure and the date
        together. The site is built and maintained by
        {" "}<a href="/about">{SITE.author.name}</a>, and every calculator cites its sources and
        carries a clear "estimate, not financial advice" note. For day-to-day decisions, you get a
        dependable answer in seconds — and a link to the source if you want to double-check.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="container mx-auto max-w-[64rem] px-4 pb-16" aria-labelledby="faq-h">
    <div class="prose max-w-[46rem]">
      <FAQ faqs={homeFaqs} />
    </div>
  </section>

  <script>
    // Hero "try it here" tabs — reveal the chosen calculator (which hydrates it).
    (function () {
      const root = document.querySelector("[data-calc-tabs]");
      if (!root) return;
      const tabs = Array.from(root.querySelectorAll('[role="tab"]'));
      const panels = Array.from(root.querySelectorAll('[role="tabpanel"]'));
      function select(i, moveFocus) {
        tabs.forEach((t, j) => {
          const on = j === i;
          t.setAttribute("aria-selected", on ? "true" : "false");
          t.tabIndex = on ? 0 : -1;
          if (panels[j]) panels[j].hidden = !on;
        });
        if (moveFocus && tabs[i]) tabs[i].focus();
      }
      tabs.forEach((tab, i) => {
        tab.addEventListener("click", () => select(i, false));
        tab.addEventListener("keydown", (e) => {
          if (e.key === "ArrowRight" || e.key === "ArrowLeft") {
            e.preventDefault();
            const dir = e.key === "ArrowRight" ? 1 : -1;
            select((i + dir + tabs.length) % tabs.length, true);
          }
        });
      });
    })();
  </script>
</BaseLayout>
