# Cloudflare Pages headers — security + caching
# https://developers.cloudflare.com/pages/configuration/headers/

# Keep the preview (*.pages.dev) domain out of search results so only the
# canonical calcyourfinance.com gets indexed.
https://calcyourfinance.pages.dev/*
  X-Robots-Tag: noindex

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Hashed, immutable build assets (JS, CSS, fonts)
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Generated OG images
/og/*
  Cache-Control: public, max-age=86400

# Long-lived static icons
/favicon.svg
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
