---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { calculators } from "../calculators";
import { TIER1, tierOf } from "../config/verification-tiers";
import { verificationLog } from "../config/verification-log";
import { rateHistory } from "../config/rate-history";

// Fee calculators only — personal-finance tools are standard, unit-tested math
// with no external rate to verify (covered separately below).
const fee = calculators.filter(
  (c) => c.kind === "single" && c.category !== "personal-finance",
);
const financeCount = calculators.filter(
  (c) => c.kind === "single" && c.category === "personal-finance",
).length;

const verifiedOn = (c: (typeof calculators)[number]) =>
  (c as { feesVerifiedOn?: string; lastUpdated: string }).feesVerifiedOn ?? c.lastUpdated;
const firstSource = (c: (typeof calculators)[number]) =>
  (c as { sources?: { label?: string; url?: string }[] }).sources?.[0];
const countryCount = (c: (typeof calculators)[number]) =>
  (c as { countries?: { supported?: string[] } }).countries?.supported?.length ?? 0;

const prettyDate = (iso: string) =>
  new Date(`${iso}T00:00:00Z`).toLocaleDateString("en-GB", {
    day: "numeric",
    month: "short",
    year: "numeric",
    timeZone: "UTC",
  });

// Per-calculator rate-change history, newest first. This drives BOTH the ●
// marker and the row order: what users care about is "did this rate change?",
// so calculators that actually changed surface at the top, most recent first.
// (Deliberately not marking the check-frequency tier here — a coloured dot next
// to a calculator reads as "this changed", which is the wrong signal.)
const changesFor = (slug: string) =>
  rateHistory
    .filter((r) => r.kind === "rate" && r.calculators.includes(slug))
    .sort((a, b) => b.effective.localeCompare(a.effective));

const rows = fee
  .map((c) => {
    const changes = changesFor(c.slug);
    return {
      c,
      changes,
      lastChange: changes[0]?.effective ?? null,
      sources: (c as { sources?: { label?: string; url?: string }[] }).sources ?? [],
    };
  })
  .sort((a, b) => {
    if (a.lastChange && b.lastChange) return b.lastChange.localeCompare(a.lastChange);
    if (a.lastChange) return -1;
    if (b.lastChange) return 1;
    return a.c.title.localeCompare(b.c.title);
  });
const changedCount = rows.filter((r) => r.lastChange).length;

const totalCountryPoints = fee.reduce((n, c) => n + Math.max(countryCount(c), 1), 0);
const latest = verificationLog[0];
// Newest-first. The most recent of each (check + change) is pinned to the top of
// the page; the full histories sit together lower so neither list pushes the
// other down the page as they grow.
const allChanges = rateHistory
  .filter((r) => r.kind === "rate")
  .sort((a, b) => b.effective.localeCompare(a.effective));
const latestChange = allChanges[0];
---

<BaseLayout
  title="Data accuracy & verification"
  description="How CalcYourFinance keeps every platform fee accurate: official sources, independent triangulation, a human check on a fixed schedule, and a public log of exactly what we checked and when."
  canonicalPath="/verification"
>
  <section class="container mx-auto max-w-[64rem] px-4 py-6 pb-16">
    <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Data accuracy" }]} />

    <p class="eyebrow mt-4">Data accuracy</p>
    <h1 class="my-3">How we keep every rate accurate.</h1>
    <p class="max-w-[42rem] text-pretty text-[17px] leading-relaxed text-body">
      A fee calculator is only worth what its numbers are worth. Every rate here comes from the
      platform's official page, is checked by a person on a fixed schedule, and is stamped with the
      date we last confirmed it. This page is the public record — what we checked, and when.
    </p>

    <!-- Stats: quick, scannable proof before any prose. -->
    <div class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-4">
      {
        [
          { n: fee.length, l: "fee calculators tracked" },
          { n: totalCountryPoints, l: "country rates verified" },
          { n: `${TIER1.size} + ${fee.length - TIER1.size}`, l: "twice-monthly + monthly" },
          { n: latest ? prettyDate(latest.date) : "—", l: "last checked" },
        ].map((s) => (
          <div class="card p-4">
            <div class="tnum text-[22px] font-semibold text-ink">{s.n}</div>
            <div class="mt-1 text-[13px] text-body">{s.l}</div>
          </div>
        ))
      }
    </div>

    <!-- The most common reason someone lands here: "is MY calculator current?"
         Give them that jump immediately, before any explanation. -->
    <div class="card mt-4 flex flex-wrap items-center justify-between gap-4 p-5">
      <div class="min-w-0">
        <p class="text-[15px] font-medium text-ink">Checking a specific calculator?</p>
        <p class="mt-1 text-[14px] text-body">
          See exactly when we last verified it, and against which source.
        </p>
      </div>
      <a href="#calculators" class="btn btn-primary shrink-0">Look up a calculator ↓</a>
    </div>

    <!-- The two things people want first: when did you last check, and what most
         recently changed. Pinned here; full histories live together lower down so
         neither pushes the other off the page as they grow. -->
    <div class="mt-4 grid gap-3 md:grid-cols-2">
      {
        latest && (
          <div class="card p-5">
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
              <p class="eyebrow">Most recent check</p>
              <p class="tnum font-mono text-[12px] text-mute">
                {latest.startUTC}–{latest.endUTC} UTC
              </p>
            </div>
            <p class="mt-2 tnum text-[17px] font-semibold text-ink">{prettyDate(latest.date)}</p>
            <p class="mt-2 text-[14px] leading-relaxed text-ink">{latest.result}</p>
            <a href="#log" class="mt-3 inline-block text-[13px] text-link no-underline hover:underline">
              Full check history ↓
            </a>
          </div>
        )
      }
      <div class="card p-5">
        <p class="eyebrow">Most recent rate change</p>
        {
          latestChange ? (
            <>
              <p class="mt-2 tnum text-[17px] font-semibold text-ink">
                {prettyDate(latestChange.effective)}
              </p>
              <p class="mt-2 text-[14px] leading-relaxed text-ink">
                <strong>{latestChange.platform}</strong> — {latestChange.field}:{" "}
                <span class="tnum">
                  {latestChange.from ?? "—"} →{" "}
                  <span class="font-medium">{latestChange.to ?? "—"}</span>
                </span>
              </p>
              <p class="mt-2 text-[13px] leading-relaxed text-body">
                <a
                  href={latestChange.source}
                  target="_blank"
                  rel="nofollow noopener"
                  class="text-link no-underline hover:underline"
                >
                  Read the announcement ↗
                </a>
              </p>
              <a href="#changes" class="mt-3 inline-block text-[13px] text-link no-underline hover:underline">
                Full change history ↓
              </a>
            </>
          ) : (
            <p class="mt-2 text-[14px] leading-relaxed text-body">
              No rate changes recorded yet — every check so far has confirmed the published rates
              unchanged.
            </p>
          )
        }
      </div>
    </div>

    <!-- Why you can trust it: method, then schedule. -->
    <h2 class="mb-3 mt-12">How each rate is verified</h2>
    <div class="prose max-w-[46rem]">
      <ol>
        <li><strong>Official source first.</strong> Each fee comes from the platform's own pricing or help page — never a third-party summary. That exact page is cited on every calculator and linked below.</li>
        <li><strong>Triangulated when a page hides its numbers.</strong> Some platforms (PayPal, Stripe, Meta, help-centre pages) render fees with JavaScript or behind a login. There we confirm the value against <strong>two or more independent, current sources</strong> and accept it only when they agree — a single result is treated as unverified.</li>
        <li><strong>A human decides.</strong> No rate changes automatically. A person reviews every check, and only then do we update the number and log the change.</li>
        <li><strong>Dated in public.</strong> Every calculator shows its "last verified" date, and each change is recorded with its source — see <a href="/methodology">our methodology</a>.</li>
      </ol>
    </div>

    <h2 class="mb-3 mt-12">Our checking schedule</h2>
    <p class="mb-4 max-w-[46rem] text-body">
      Rates change rarely, but when they do it matters. So we re-verify on a fixed cadence — more
      often for the platforms where a change is most likely, or most costly to get wrong.
    </p>
    <div class="grid gap-3 sm:grid-cols-2">
      <div class="card p-5">
        <p class="text-[13px] font-medium text-accent">Twice a month · 1st &amp; 15th</p>
        <p class="mt-1 text-[15px] font-medium text-ink">Tier 1 — {TIER1.size} calculators</p>
        <p class="mt-2 text-[14px] leading-relaxed text-body">
          Payment processors spanning many countries, the highest-traffic marketplaces, and
          platforms whose fees are actively changing.
        </p>
      </div>
      <div class="card p-5">
        <p class="text-[13px] font-medium text-body">Once a month · 1st</p>
        <p class="mt-1 text-[15px] font-medium text-ink">Tier 2 — {fee.length - TIER1.size} calculators</p>
        <p class="mt-2 text-[14px] leading-relaxed text-body">
          Stable, mostly single-rate platforms. Any change a platform announces is applied
          immediately, not held for the schedule.
        </p>
      </div>
    </div>
    <p class="mt-4 max-w-[46rem] text-[14px] leading-relaxed text-body">
      <strong class="text-ink">Every check is full scope.</strong> Whichever tier a calculator is in,
      when it's due we re-verify every country and every fee variant it covers — never a sample. The
      tiers change how <em>often</em> we check, never how <em>thoroughly</em>.
    </p>

    <!-- The lookup table: the page's main utility, and the jump target. -->
    <h2 id="calculators" class="mb-2 mt-12 scroll-mt-20">Every calculator, last verified</h2>
    <p class="mb-3 max-w-[46rem] text-body">
      When we last confirmed each platform's rates, how many countries the tool covers, and the
      source we check it against.
    </p>
    <div class="mb-4 max-w-[46rem] rounded-md border border-hairline bg-canvas-soft p-4 text-[13px] leading-relaxed text-body">
      <p>
        <span class="text-accent">●</span> <strong class="text-ink">marks a calculator whose rates
        have changed</strong> since we began tracking. Those are listed first, most recent change at
        the top. Click any row to see exactly what changed and the announcement it came from.
      </p>
      <p class="mt-2">
        <strong class="text-ink">Rates last verified</strong> is the date we last completed a
        <em>full</em> check of that calculator against its official source — every country and
        variant. It only moves when a full check is finished, so it can be older than today even
        though the tool is current: it means nothing has changed since that date.
      </p>
    </div>
    <label class="sr-only" for="verify-search">Search calculators</label>
    <input
      id="verify-search"
      type="search"
      placeholder="Search a calculator — e.g. Stripe, Etsy, PayPal…"
      autocomplete="off"
      class="field-control mb-1 w-full max-w-[24rem]"
    />
    <p id="verify-noresult" class="hidden py-3 text-[14px] text-mute">No calculator matches that.</p>
    <div id="verify-list" class="overflow-x-auto">
      <table class="w-full min-w-[52rem] border-collapse text-[14px]">
        <thead>
          <tr class="border-b border-hairline text-left text-[12px] uppercase tracking-wide text-mute">
            <th scope="col" class="py-2 pr-3 font-medium">Calculator</th>
            <th scope="col" class="py-2 pr-3 font-medium">Rates last verified</th>
            <th scope="col" class="py-2 pr-3 font-medium">Check frequency</th>
            <th scope="col" class="py-2 pr-3 font-medium">Coverage</th>
            <th scope="col" class="py-2 pr-3 font-medium">Last rate change</th>
            <th scope="col" class="py-2 font-medium"><span class="sr-only">Details</span></th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map(({ c, changes, lastChange, sources }) => (
              <Fragment>
                <tr
                  class="cursor-pointer border-b border-hairline transition hover:bg-canvas-soft"
                  data-row
                  data-name={c.title.toLowerCase()}
                  data-slug={c.slug}
                >
                  <td class="py-2.5 pr-3">
                    {lastChange && (
                      <span class="text-accent" title="Rates have changed">●</span>
                    )}{" "}
                    <a href={`/${c.slug}`} class="text-ink no-underline hover:underline">
                      {c.title}
                    </a>
                  </td>
                  <td class="tnum whitespace-nowrap py-2.5 pr-3 text-body">{prettyDate(verifiedOn(c))}</td>
                  <td class="whitespace-nowrap py-2.5 pr-3 text-body">
                    {tierOf(c.slug) === 1 ? "Every 15 days — 1st & 15th" : "Monthly — 1st"}
                  </td>
                  <td class="whitespace-nowrap py-2.5 pr-3 text-mute">
                    {countryCount(c) > 1 ? `${countryCount(c)} countries` : "single rate"}
                  </td>
                  <td class="tnum whitespace-nowrap py-2.5 pr-3 text-body">
                    {lastChange ? prettyDate(lastChange) : "—"}
                  </td>
                  <td class="py-2.5 text-right">
                    <button
                      type="button"
                      data-toggle
                      aria-expanded="false"
                      aria-controls={`detail-${c.slug}`}
                      class="rounded-md px-2 py-1 text-mute transition hover:text-ink"
                    >
                      <span class="sr-only">Show verification detail for {c.title}</span>
                      <span aria-hidden="true" data-chev class="inline-block transition">▾</span>
                    </button>
                  </td>
                </tr>
                <tr id={`detail-${c.slug}`} class="hidden border-b border-hairline" data-detail>
                  <td colspan="6" class="bg-canvas-soft px-3 py-4">
                    {changes.length > 0 ? (
                      <>
                        <p class="mb-2 text-[13px] font-medium text-ink">What changed</p>
                        <ul class="flex flex-col gap-2">
                          {changes.map((ch) => (
                            <li class="text-[13px] leading-relaxed text-body">
                              <span class="tnum text-ink">{prettyDate(ch.effective)}</span> — {ch.field}:{" "}
                              <span class="tnum">
                                {ch.from ?? "—"} → <span class="font-medium text-ink">{ch.to ?? "—"}</span>
                              </span>{" "}
                              <a
                                href={ch.source}
                                target="_blank"
                                rel="nofollow noopener"
                                class="text-link no-underline hover:underline"
                              >
                                announcement ↗
                              </a>
                              {ch.note && <span class="mt-0.5 block text-mute">{ch.note}</span>}
                            </li>
                          ))}
                        </ul>
                      </>
                    ) : (
                      <p class="text-[13px] leading-relaxed text-body">
                        No rate change recorded since we began tracking — at each scheduled check the
                        published rates were re-confirmed unchanged.
                      </p>
                    )}
                    {sources.length > 0 && (
                      <div class="mt-3 border-t border-hairline pt-3">
                        <p class="mb-1 text-[13px] font-medium text-ink">Official sources we check</p>
                        <ul class="flex flex-col gap-1">
                          {sources.map(
                            (s) =>
                              s.url && (
                                <li class="text-[13px]">
                                  <a
                                    href={s.url}
                                    target="_blank"
                                    rel="nofollow noopener"
                                    class="text-link no-underline hover:underline"
                                  >
                                    {s.label ?? s.url} ↗
                                  </a>
                                </li>
                              ),
                          )}
                        </ul>
                      </div>
                    )}
                  </td>
                </tr>
              </Fragment>
            ))
          }
        </tbody>
      </table>
    </div>

    <p class="mt-6 max-w-[46rem] text-[14px] leading-relaxed text-body">
      Our {financeCount} personal-finance calculators (loan, EMI, compound interest and the rest)
      aren't listed here because they don't depend on a platform's rates — they're standard textbook
      formulas, and each is covered by automated tests so the math is reproducible.
    </p>

    <!-- History: every session, then every change. -->
    <h2 id="log" class="mb-3 mt-12 scroll-mt-20">Verification history</h2>
    <p class="mb-4 max-w-[46rem] text-body">Every check we've run, newest first.</p>
    <div class="flex flex-col gap-3">
      {
        verificationLog.map((s) => (
          <div class="card p-5">
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
              <p class="tnum text-[15px] font-semibold text-ink">{prettyDate(s.date)}</p>
              <p class="tnum font-mono text-[12px] text-mute">
                {s.startUTC}–{s.endUTC} UTC · {s.slot}
              </p>
            </div>
            <p class="mt-2 text-[14px] leading-relaxed text-ink">{s.result}</p>
            <p class="mt-2 text-[13px] leading-relaxed text-body">{s.scope}</p>
            <p class="mt-1 text-[13px] text-mute">Coverage: {s.coverage}</p>
            <p class="mt-1 text-[13px] text-mute">Method: {s.method}</p>
          </div>
        ))
      }
    </div>

    {
      allChanges.length > 0 && (
        <>
          <h2 id="changes" class="mb-3 mt-12 scroll-mt-20">Rate change history</h2>
          <p class="mb-4 max-w-[46rem] text-body">
            Every fee change we've applied, newest first, with the announcement we took it from.
          </p>
          <div class="overflow-x-auto">
            <table class="w-full min-w-[36rem] border-collapse text-[14px]">
              <thead>
                <tr class="border-b border-hairline text-left text-[12px] uppercase tracking-wide text-mute">
                  <th class="py-2 pr-4 font-medium">Effective</th>
                  <th class="py-2 pr-4 font-medium">Platform</th>
                  <th class="py-2 pr-4 font-medium">What changed</th>
                  <th class="py-2 pr-4 font-medium">From → To</th>
                  <th class="py-2 font-medium">Source</th>
                </tr>
              </thead>
              <tbody>
                {allChanges.map((r) => (
                  <tr class="border-b border-hairline">
                    <td class="tnum py-2.5 pr-4 text-body">{prettyDate(r.effective)}</td>
                    <td class="py-2.5 pr-4 text-ink">{r.platform}</td>
                    <td class="py-2.5 pr-4 text-body">{r.field}</td>
                    <td class="tnum py-2.5 pr-4 text-body">
                      {r.from ?? "—"} → <span class="text-ink">{r.to ?? "—"}</span>
                    </td>
                    <td class="py-2.5">
                      <a href={r.source} rel="nofollow noopener" target="_blank" class="text-link no-underline hover:underline">
                        official ↗
                      </a>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </>
      )
    }

    <div class="card mt-10 flex flex-wrap items-center justify-between gap-4 p-5">
      <p class="text-[14px] text-body">
        Spotted a fee that looks out of date? Tell us and we'll verify it fast.
      </p>
      <a href="/contact" class="btn btn-secondary shrink-0">Report a rate</a>
    </div>
  </section>

  <script>
    // Filter the per-calculator table so a user can find their tool's last-checked
    // date. Progressive enhancement — the full list is server-rendered and works
    // without JS; this only narrows it.
    const list = document.getElementById("verify-list");
    if (list) {
      const rows = Array.from(list.querySelectorAll<HTMLElement>("tr[data-row]"));
      const detailOf = (row: HTMLElement) => {
        const next = row.nextElementSibling as HTMLElement | null;
        return next?.hasAttribute("data-detail") ? next : null;
      };
      const setOpen = (row: HTMLElement, open: boolean) => {
        const d = detailOf(row);
        if (!d) return;
        d.classList.toggle("hidden", !open);
        row.querySelector("[data-toggle]")?.setAttribute("aria-expanded", String(open));
        const chev = row.querySelector<HTMLElement>("[data-chev]");
        if (chev) chev.style.transform = open ? "rotate(180deg)" : "";
      };

      // Click anywhere on the row to reveal what changed — but let real links
      // (the calculator, the sources) behave normally.
      for (const row of rows) {
        row.addEventListener("click", (e) => {
          if ((e.target as HTMLElement).closest("a")) return;
          const d = detailOf(row);
          if (d) setOpen(row, d.classList.contains("hidden"));
        });
      }

      const input = document.getElementById("verify-search") as HTMLInputElement | null;
      const noResult = document.getElementById("verify-noresult");
      input?.addEventListener("input", () => {
        const q = input.value.trim().toLowerCase();
        let any = false;
        for (const row of rows) {
          const match =
            !q || (row.dataset.name ?? "").includes(q) || (row.dataset.slug ?? "").includes(q);
          row.style.display = match ? "" : "none";
          const d = detailOf(row);
          if (d) {
            d.style.display = match ? "" : "none";
            if (!match) setOpen(row, false); // collapse anything filtered away
          }
          if (match) any = true;
        }
        noResult?.classList.toggle("hidden", any);
      });
    }
  </script>
</BaseLayout>
