---
/** Category hub (PLAN §6) — targets a broader term, links to its calculators. */
import type { Category } from "../calculators/_types";
import { CATEGORY_META } from "../calculators/_types";
import { calculatorsByCategory } from "../calculators";
import Breadcrumbs from "./Breadcrumbs.astro";

interface Props {
  category: Category;
}
const { category } = Astro.props;
const meta = CATEGORY_META[category];
const items = calculatorsByCategory(category);
---

<section class="container mx-auto max-w-[64rem] px-4 py-6 pb-16">
  <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: meta.label }]} />
  <header class="my-6 max-w-[48rem]">
    <p class="eyebrow">{meta.label}</p>
    <h1 class="mt-1">{meta.label} calculators</h1>
    <p class="mt-3 text-[18px] text-body">{meta.blurb}</p>
  </header>

  <ul class="grid list-none gap-4 p-0 [grid-template-columns:repeat(auto-fill,minmax(18rem,1fr))]">
    {
      items.map((c) => (
        <li>
          <a href={`/${c.slug}`} class="card flex h-full flex-col gap-2 p-5 no-underline transition hover:border-hairline-strong hover:shadow-float">
            <h2 class="text-[18px] text-ink">{c.title}</h2>
            <p class="text-[14px] leading-relaxed text-body">{c.intro}</p>
            <span class="mt-auto pt-1 text-[14px] font-medium text-link">Open calculator →</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>
